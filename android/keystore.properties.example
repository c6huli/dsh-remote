# 复制成 keystore.properties 并填入你自己的签名信息。
# 这个文件必须留在本地，不要提交（.gitignore 已排除）。
#
# 生成一个自己的 keystore：
#   keytool -genkeypair -v -keystore my-release.jks -alias dshremote \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Windows 路径请用正斜杠或双反斜杠。

storeFile=D:/path/to/my-release.jks
storePassword=你的store密码
keyAlias=dshremote
keyPassword=你的key密码
